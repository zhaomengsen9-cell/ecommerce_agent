FRAPPE_BASE_URL=http://localhost:8080
FRAPPE_SITE=frontend

DATABASE_URL=postgresql+psycopg://agent:agent123@localhost:5432/ecommerce_agent

# Prefer ERPNext API token in non-local environments.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Local fallback account for the demo ERPNext container.
FRAPPE_USERNAME=Administrator
FRAPPE_PASSWORD=admin

# Examples:
# AGENT_MODEL=deepseek:deepseek-chat
# AGENT_MODEL=openai:gpt-4.1
AGENT_MODEL=deepseek:deepseek-chat

HUMAN_APPROVAL_MODE=terminal
ERP_MCP_TRANSPORT=stdio
AGENT_MEMORY_DIR=.agent_memory
